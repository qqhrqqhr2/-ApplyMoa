function Get-BytesDigest([byte[]]$Bytes) {
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try { return [BitConverter]::ToString($sha.ComputeHash($Bytes)).Replace('-', '').ToLowerInvariant() }
    finally { $sha.Dispose() }
}

function Get-CheckedPayload {
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $bytes = [Convert]::FromBase64String($script:EmbeddedZip)
    if ((Get-BytesDigest $bytes) -ne $script:ZipDigest) { throw '설치 파일이 손상되었습니다. 파일을 다시 내려받아 주세요.' }
    $stream = [System.IO.MemoryStream]::new($bytes, $false)
    $archive = [System.IO.Compression.ZipArchive]::new($stream, [System.IO.Compression.ZipArchiveMode]::Read, $false)
    try {
        foreach ($entry in $archive.Entries) {
            $name = $entry.FullName
            if (!$name.StartsWith('apply-moa/', [StringComparison]::Ordinal) -or $name -match '(^/|(^|/)\.\.(/|$)|:|\\)') {
                throw '설치 파일의 경로를 확인할 수 없습니다.'
            }
        }
        $entry = $archive.GetEntry('apply-moa/manifest.json')
        if (!$entry) { throw '확장 프로그램 정보가 없습니다.' }
        $reader = [System.IO.StreamReader]::new($entry.Open(), [System.Text.Encoding]::UTF8)
        try { $manifest = $reader.ReadToEnd() | ConvertFrom-Json }
        finally { $reader.Dispose() }
        if ($manifest.name -ne '채용지원모아' -or $manifest.version -ne $script:AppVersion -or $manifest.manifest_version -ne 3) {
            throw '설치할 확장 프로그램 정보를 확인할 수 없습니다.'
        }
        foreach ($required in @('background.js','core.js','content.js','runner.js','dashboard.js','dashboard.html','dashboard.css','icons/16.png','icons/32.png','icons/48.png','icons/128.png')) {
            if (!$archive.GetEntry('apply-moa/' + $required)) { throw ('설치에 필요한 파일이 없습니다: ' + $required) }
        }
    } finally { $archive.Dispose(); $stream.Dispose() }
    return ,$bytes
}

function Get-OwnedManifest([string]$Directory) {
    $path = Join-Path $Directory 'manifest.json'
    if (![System.IO.File]::Exists($path)) { return $null }
    try { $manifest = [System.IO.File]::ReadAllText($path, [System.Text.Encoding]::UTF8) | ConvertFrom-Json }
    catch { throw '선택한 폴더의 manifest.json을 읽을 수 없습니다.' }
    if ($manifest.name -notin @('채용지원모아','입사지원 도우미','펌웨어 지원 도우미') -or $manifest.manifest_version -ne 3) {
        throw '다른 프로그램 폴더입니다. 도우미 설치 폴더 또는 비어 있는 폴더를 선택해 주세요.'
    }
    return $manifest
}

function Install-ApplyHelper([string]$Directory, [byte[]]$Payload) {
    if ([string]::IsNullOrWhiteSpace($Directory)) { throw '설치 위치가 비어 있습니다.' }
    $target = [System.IO.Path]::GetFullPath($Directory)
    $trimChars = [char[]]@('\','/')
    if ($target.TrimEnd($trimChars) -eq [System.IO.Path]::GetPathRoot($target).TrimEnd($trimChars)) {
        throw '드라이브의 최상위 폴더에는 설치할 수 없습니다. 설치용 폴더를 선택해 주세요.'
    }
    if ([System.IO.File]::Exists($target)) { throw '설치 위치가 폴더가 아닌 파일입니다.' }
    $existed = [System.IO.Directory]::Exists($target)
    $oldManifest = Get-OwnedManifest $target
    if ($existed -and !$oldManifest -and @(Get-ChildItem -LiteralPath $target -Force).Count -gt 0) {
        throw '선택한 폴더에 다른 파일이 있습니다. 비어 있는 폴더나 기존 도우미 폴더를 선택해 주세요.'
    }
    $temporary = Join-Path ([System.IO.Path]::GetTempPath()) ('ApplyHelperSetup-' + [Guid]::NewGuid().ToString('N'))
    $written = [System.Collections.Generic.List[object]]::new()
    try {
        [void][System.IO.Directory]::CreateDirectory($temporary)
        $zipPath = Join-Path $temporary 'payload.zip'
        [System.IO.File]::WriteAllBytes($zipPath, $Payload)
        $expanded = Join-Path $temporary 'expanded'
        [System.IO.Compression.ZipFile]::ExtractToDirectory($zipPath, $expanded)
        $sourceRoot = Join-Path $expanded 'apply-moa'
        $backupRoot = Join-Path $temporary 'backup'
        [void][System.IO.Directory]::CreateDirectory($target)
        foreach ($source in @(Get-ChildItem -LiteralPath $sourceRoot -File -Recurse | Sort-Object FullName)) {
            $relative = $source.FullName.Substring($sourceRoot.Length + 1)
            $destination = Join-Path $target $relative
            $backup = Join-Path $backupRoot $relative
            $hadFile = [System.IO.File]::Exists($destination)
            if ($hadFile) {
                [void][System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($backup))
                [System.IO.File]::Copy($destination, $backup, $true)
            }
            [void][System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($destination))
            $written.Add([pscustomobject]@{ Path=$destination; Backup=$backup; HadFile=$hadFile })
            [System.IO.File]::Copy($source.FullName, $destination, $true)
            if ((Get-BytesDigest ([System.IO.File]::ReadAllBytes($destination))) -ne (Get-BytesDigest ([System.IO.File]::ReadAllBytes($source.FullName)))) {
                throw ('설치한 파일을 확인할 수 없습니다: ' + $relative)
            }
        }
        return [pscustomobject]@{ Directory=$target; Version=$script:AppVersion; Updated=([bool]$oldManifest); FileCount=$written.Count }
    } catch {
        $originalError = $_
        for ($index=$written.Count-1; $index -ge 0; $index--) {
            $item = $written[$index]
            try {
                if ($item.HadFile) { [System.IO.File]::Copy($item.Backup, $item.Path, $true) }
                elseif ([System.IO.File]::Exists($item.Path)) { [System.IO.File]::Delete($item.Path) }
            } catch { Write-Warning ('복구하지 못한 파일: ' + $item.Path) }
        }
        if (!$existed -and [System.IO.Directory]::Exists($target)) {
            foreach ($directory in @(Get-ChildItem -LiteralPath $target -Directory -Recurse | Sort-Object FullName -Descending)) {
                if (@(Get-ChildItem -LiteralPath $directory.FullName -Force).Count -eq 0) { [System.IO.Directory]::Delete($directory.FullName) }
            }
            if (@(Get-ChildItem -LiteralPath $target -Force).Count -eq 0) { [System.IO.Directory]::Delete($target) }
        }
        throw $originalError
    } finally {
        if ([System.IO.Directory]::Exists($temporary)) { Remove-Item -LiteralPath $temporary -Recurse -Force -ErrorAction SilentlyContinue }
    }
}

function Select-InstallDirectory([string]$DefaultDirectory) {
    Add-Type -AssemblyName System.Windows.Forms
    Add-Type -AssemblyName System.Drawing
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $form = New-Object System.Windows.Forms.Form
    $form.Text = '채용지원모아 ' + $script:AppVersion + ' 설치'
    $form.ClientSize = [System.Drawing.Size]::new(690,245)
    $form.FormBorderStyle = 'FixedDialog'
    $form.StartPosition = 'CenterScreen'
    $form.MaximizeBox = $false
    $form.MinimizeBox = $false
    $form.Font = [System.Drawing.Font]::new('Malgun Gothic',[float]9)
    $heading = New-Object System.Windows.Forms.Label
    $heading.Text = '설치할 폴더'
    $heading.SetBounds(22,20,630,25)
    $path = New-Object System.Windows.Forms.TextBox
    $path.Text = $DefaultDirectory
    $path.SetBounds(22,53,536,29)
    $browse = New-Object System.Windows.Forms.Button
    $browse.Text = '폴더 선택'
    $browse.SetBounds(568,50,98,32)
    $browse.Add_Click({
        $picker = New-Object System.Windows.Forms.FolderBrowserDialog
        $picker.Description = '기존 설치를 업데이트하려면 manifest.json이 있는 기존 폴더를 선택하세요.'
        $picker.ShowNewFolderButton = $true
        if ([System.IO.Directory]::Exists($path.Text)) { $picker.SelectedPath = $path.Text }
        if ($picker.ShowDialog($form) -eq [System.Windows.Forms.DialogResult]::OK) { $path.Text = $picker.SelectedPath }
        $picker.Dispose()
    })
    $note = New-Object System.Windows.Forms.Label
    $note.Text = @'
처음 설치하면 위 기본 폴더에 파일을 자동 배치합니다.
이미 사용 중이면 [폴더 선택]으로 기존에 등록한 폴더를 선택하세요.
같은 폴더에 업데이트하면 기존 크롬 설정과 지원 기록을 유지할 수 있습니다.
파일 배치 후 크롬 확장 프로그램 등록 또는 새로고침을 안내합니다.
'@
    $note.SetBounds(22,96,645,85)
    $install = New-Object System.Windows.Forms.Button
    $install.Text = '설치 / 업데이트'
    $install.SetBounds(419,195,143,32)
    $install.DialogResult = [System.Windows.Forms.DialogResult]::OK
    $cancel = New-Object System.Windows.Forms.Button
    $cancel.Text = '취소'
    $cancel.SetBounds(572,195,94,32)
    $cancel.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
    $form.AcceptButton = $install
    $form.CancelButton = $cancel
    $form.Controls.AddRange(@($heading,$path,$browse,$note,$install,$cancel))
    try {
        if ($form.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { return $null }
        return $path.Text
    } finally { $form.Dispose() }
}

function Find-Chrome {
    $candidates = [System.Collections.Generic.List[string]]::new()
    foreach ($root in @($env:LOCALAPPDATA,$env:ProgramFiles,[Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))) {
        if ($root) { $candidates.Add((Join-Path $root 'Google\Chrome\Application\chrome.exe')) }
    }
    foreach ($candidate in $candidates) { if ([System.IO.File]::Exists($candidate)) { return $candidate } }
    $command = Get-Command chrome.exe -ErrorAction SilentlyContinue
    if ($command) { return $command.Source }
    return $null
}

try {
    $payload = Get-CheckedPayload
    if ($ValidateOnly) {
        [pscustomobject]@{ Version=$script:AppVersion; PayloadBytes=$payload.Length; Digest=$script:ZipDigest } | ConvertTo-Json -Compress
        return
    }
    if (!$NoUI -and $env:OS -ne 'Windows_NT') { throw '이 설치 파일은 윈도우 PC용입니다.' }
    if ([string]::IsNullOrWhiteSpace($InstallDir)) {
        if (!$env:LOCALAPPDATA) { throw '설치 위치를 지정해 주세요.' }
        $InstallDir = Join-Path $env:LOCALAPPDATA 'ApplyMoa\apply-moa'
    }
    if (!$NoUI) {
        $InstallDir = Select-InstallDirectory $InstallDir
        if (!$InstallDir) { return }
    }
    $result = Install-ApplyHelper $InstallDir $payload
    if ($NoUI) { $result | ConvertTo-Json -Compress; return }
    $copied = $false
    try { [System.Windows.Forms.Clipboard]::SetText($result.Directory); $copied = $true }
    catch { Write-Host '설치 경로를 복사하지 못했습니다. 아래 표시된 경로를 직접 복사해 주세요.' }
    $chrome = Find-Chrome
    if ($chrome) {
        try {
            $desktop = [Environment]::GetFolderPath('DesktopDirectory')
            if ($desktop -and [System.IO.Directory]::Exists($desktop)) {
                $shortcutPath = Join-Path $desktop '채용지원모아 관리.lnk'
                if (![System.IO.File]::Exists($shortcutPath)) {
                    $shell = New-Object -ComObject WScript.Shell
                    $shortcut = $shell.CreateShortcut($shortcutPath)
                    $shortcut.TargetPath = $chrome
                    $shortcut.Arguments = 'chrome://extensions/'
                    $shortcut.Description = '채용지원모아 확장 프로그램 관리'
                    $shortcut.Save()
                }
            }
        } catch { Write-Host '바탕화면 바로가기는 만들지 못했지만 파일 배치는 완료했습니다.' }
        try { Start-Process -FilePath $chrome -ArgumentList @('chrome://extensions/') }
        catch { Write-Host '크롬 주소창에 chrome://extensions 를 직접 입력해 주세요.' }
    }
    $message = '파일 배치 완료: ' + $result.Directory + [Environment]::NewLine + [Environment]::NewLine
    if ($copied) { $message += '설치 경로를 복사했습니다. 폴더 선택 창에서 Ctrl+V로 붙여넣으세요.' + [Environment]::NewLine + [Environment]::NewLine }
    $message += @'
처음 등록:
1. 로그인한 크롬 프로필에서 chrome://extensions 를 엽니다.
2. 오른쪽 위 [개발자 모드]를 켭니다.
3. [압축해제된 확장 프로그램 로드]를 누릅니다.
4. 위 경로를 붙여넣고 [폴더 선택]을 누릅니다.

기존 등록 폴더에 업데이트한 경우:
도우미 확장 프로그램의 [새로고침] 버튼을 누릅니다.

사용 안내:
도우미에서 검색어와 기업·채용 형태·희망 지역을 설정하세요. 지원에는 각 사이트에 등록된 이력서를 사용합니다.

그다음 확장 프로그램 메뉴에서 [채용지원모아]를 엽니다.
'@
    Write-Host $message
    [void][System.Windows.Forms.MessageBox]::Show($message, '채용지원모아 설치 안내', [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
} catch {
    $message = '설치하지 못했습니다: ' + $_.Exception.Message
    Write-Host $message -ForegroundColor Red
    if (!$NoUI -and !$ValidateOnly -and $env:OS -eq 'Windows_NT') {
        Add-Type -AssemblyName System.Windows.Forms
        [void][System.Windows.Forms.MessageBox]::Show($message, '채용지원모아', [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
    }
    exit 1
}
